diff --git a/users/delete.go b/users/delete.go
new file mode 100644
index 0000000..0a5693d
--- /dev/null
+++ b/users/delete.go
@@ -0,0 +1,49 @@
+package users
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gothinkster/golang-gin-realworld-example-app/common"
+	"gorm.io/gorm"
+)
+
+// UserDeleteHook removes the data another package keeps for a user. It runs inside the deletion transaction.
+type UserDeleteHook func(tx *gorm.DB, user UserModel) error
+
+var userDeleteHooks []UserDeleteHook
+
+// OnUserDelete registers a hook that runs when an account is deleted. Packages that keep per-user data (articles)
+// import users, so users cannot call them directly.
+func OnUserDelete(hook UserDeleteHook) {
+	userDeleteHooks = append(userDeleteHooks, hook)
+}
+
+// DeleteUser deletes the account, its follows (both directions) and, through the hooks, the data of other packages.
+func DeleteUser(user UserModel) error {
+	return common.GetDB().Transaction(func(tx *gorm.DB) error {
+		for _, hook := range userDeleteHooks {
+			if err := hook(tx, user); err != nil {
+				return err
+			}
+		}
+		if err := tx.Where("following_id = ? OR followed_by_id = ?", user.ID, user.ID).Delete(&FollowModel{}).Error; err != nil {
+			return err
+		}
+		return tx.Delete(&UserModel{}, user.ID).Error
+	})
+}
+
+// UserDelete deletes the account of the signed-in user.
+func UserDelete(c *gin.Context) {
+	myUserModel := c.MustGet("my_user_model").(UserModel)
+	if myUserModel.ID == 0 {
+		c.AbortWithStatus(http.StatusUnauthorized)
+		return
+	}
+	if err := DeleteUser(myUserModel); err != nil {
+		c.JSON(http.StatusUnprocessableEntity, common.NewError("database", err))
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"user": "delete success"})
+}
