+package articles
+
+import (
+	"github.com/gothinkster/golang-gin-realworld-example-app/users"
+	"gorm.io/gorm"
+)
+
+// DeleteUserData removes everything this package keeps for a user who deletes the account. Articles, comments and
+// favorites point to the user's ArticleUserModel (not to the UserModel id).
+func DeleteUserData(tx *gorm.DB, user users.UserModel) error {
+	var author ArticleUserModel
+	if err := tx.Where("user_model_id = ?", user.ID).Limit(1).Find(&author).Error; err != nil {
+		return err
+	}
+	if author.ID == 0 {
+		return nil
+	}
+	var articleIDs []uint
+	if err := tx.Model(&ArticleModel{}).Where("author_id = ?", author.ID).Pluck("id", &articleIDs).Error; err != nil {
+		return err
+	}
+	if len(articleIDs) > 0 {
+		if err := tx.Where("favorite_id IN ?", articleIDs).Delete(&FavoriteModel{}).Error; err != nil {
+			return err
+		}
+		if err := tx.Where("article_id IN ?", articleIDs).Delete(&CommentModel{}).Error; err != nil {
+			return err
+		}
+		if err := tx.Where("id IN ?", articleIDs).Delete(&ArticleModel{}).Error; err != nil {
+			return err
+		}
+	}
+	if err := tx.Where("favorite_by_id = ?", author.ID).Delete(&FavoriteModel{}).Error; err != nil {
+		return err
+	}
+	if err := tx.Where("author_id = ?", author.ID).Delete(&CommentModel{}).Error; err != nil {
+		return err
+	}
+	return tx.Delete(&author).Error
+}
