+package org.springframework.samples.petclinic.owner;
+
+import org.springframework.data.domain.Sort;
+import org.springframework.samples.petclinic.system.Csv;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/**
+ * CSV export of the owners.
+ */
+@RestController
+class OwnerCsvController {
+
+	private final OwnerRepository owners;
+
+	OwnerCsvController(OwnerRepository owners) {
+		this.owners = owners;
+	}
+
+	@GetMapping(value = "/owners.csv", produces = Csv.TEXT_CSV)
+	String exportOwners() {
+		StringBuilder csv = new StringBuilder(Csv.line("id", "firstName", "lastName", "city", "telephone"));
+		for (Owner owner : this.owners.findAll(Sort.by("id"))) {
+			csv.append(Csv.line(owner.getId(), owner.getFirstName(), owner.getLastName(), owner.getCity(),
+					owner.getTelephone()));
+		}
+		return csv.toString();
+	}
+
+}
