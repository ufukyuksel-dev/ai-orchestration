+package org.springframework.samples.petclinic.owner;
+
+import java.time.LocalDate;
+import java.util.List;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.server.ResponseStatusException;
+
+/**
+ * Read-only JSON API for owners.
+ */
+@RestController
+class OwnerRestController {
+
+	private final OwnerRepository owners;
+
+	OwnerRestController(OwnerRepository owners) {
+		this.owners = owners;
+	}
+
+	@GetMapping("/api/owners/{ownerId}")
+	OwnerJson showOwner(@PathVariable int ownerId) {
+		Owner owner = this.owners.findById(ownerId)
+			.orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "Owner not found: " + ownerId));
+		return OwnerJson.of(owner);
+	}
+
+	record OwnerJson(Integer id, String firstName, String lastName, String address, String city, String telephone,
+			List<PetJson> pets) {
+
+		static OwnerJson of(Owner owner) {
+			return new OwnerJson(owner.getId(), owner.getFirstName(), owner.getLastName(), owner.getAddress(),
+					owner.getCity(), owner.getTelephone(), owner.getPets().stream().map(PetJson::of).toList());
+		}
+
+	}
+
+	record PetJson(Integer id, String name, LocalDate birthDate, String type) {
+
+		static PetJson of(Pet pet) {
+			return new PetJson(pet.getId(), pet.getName(), pet.getBirthDate(),
+					pet.getType() != null ? pet.getType().getName() : null);
+		}
+
+	}
+
+}
