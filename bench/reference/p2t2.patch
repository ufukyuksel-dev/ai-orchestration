+@bp.route('/user/<username>/followers.csv')
+@login_required
+def followers_csv(username):
+    user = db.first_or_404(sa.select(User).where(User.username == username))
+    query = user.followers.select().order_by(User.username.asc())
+    rows = [['username', 'about_me', 'posts']]
+    for follower in db.session.scalars(query):
+        rows.append([follower.username, follower.about_me or '',
+                     follower.posts_count()])
+    return csv_response(rows, f'{user.username}-followers.csv')
