+def csv_response(rows, filename):
+    out = io.StringIO()
+    csv.writer(out).writerows(rows)
+    return Response(out.getvalue(), mimetype='text/csv', headers={
+        'Content-Disposition': f'attachment; filename={filename}'})
+
