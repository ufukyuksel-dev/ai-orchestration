+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/**
+ * Read-only JSON API for veterinarians.
+ */
+@RestController
+class VetRestController {
+
+	private final VetRepository vetRepository;
+
+	VetRestController(VetRepository vetRepository) {
+		this.vetRepository = vetRepository;
+	}
+
+	@GetMapping("/api/vets")
+	List<VetJson> listVets() {
+		return this.vetRepository.findAll().stream().map(VetJson::of).toList();
+	}
+
+	record VetJson(Integer id, String firstName, String lastName, List<String> specialties) {
+
+		static VetJson of(Vet vet) {
+			// Vet#getSpecialties() is already sorted by name
+			return new VetJson(vet.getId(), vet.getFirstName(), vet.getLastName(),
+					vet.getSpecialties().stream().map(NamedEntity::getName).toList());
+		}
+
+	}
+
+}
