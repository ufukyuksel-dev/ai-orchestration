@@ -0,0 +1,42 @@
+package articles
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gothinkster/golang-gin-realworld-example-app/common"
+	"github.com/gothinkster/golang-gin-realworld-example-app/users"
+)
+
+// ProfileStatsAnonymousRegister registers the read-only profile statistics endpoint.
+// It lives in this package because the counts need the article models (users cannot import articles).
+func ProfileStatsAnonymousRegister(router *gin.RouterGroup) {
+	router.GET("/:username/stats", ProfileStats)
+}
+
+// ProfileStats returns the number of articles, comments, followers and followings of a user.
+func ProfileStats(c *gin.Context) {
+	userModel, err := users.FindOneUser(&users.UserModel{Username: c.Param("username")})
+	if err != nil {
+		c.JSON(http.StatusNotFound, common.NewError("profile", errors.New("Invalid username")))
+		return
+	}
+	db := common.GetDB()
+	var articlesCount, commentsCount, followersCount, followingCount int64
+	// Articles and comments reference the ArticleUserModel, not the UserModel.
+	var articleUser ArticleUserModel
+	if db.Where(&ArticleUserModel{UserModelID: userModel.ID}).Limit(1).Find(&articleUser).Error == nil && articleUser.ID != 0 {
+		db.Model(&ArticleModel{}).Where("author_id = ?", articleUser.ID).Count(&articlesCount)
+		db.Model(&CommentModel{}).Where("author_id = ?", articleUser.ID).Count(&commentsCount)
+	}
+	db.Model(&users.FollowModel{}).Where("following_id = ?", userModel.ID).Count(&followersCount)
+	db.Model(&users.FollowModel{}).Where("followed_by_id = ?", userModel.ID).Count(&followingCount)
+	c.JSON(http.StatusOK, gin.H{"stats": gin.H{
+		"username":       userModel.Username,
+		"articlesCount":  articlesCount,
+		"commentsCount":  commentsCount,
+		"followersCount": followersCount,
+		"followingCount": followingCount,
+	}})
+}
