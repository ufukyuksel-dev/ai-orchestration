+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Pet lookup and the adding of pets and visits on {@link Owner}.
+ */
+class OwnerPetsTests {
+
+	private Owner owner;
+
+	private Pet leo;
+
+	private Pet basil;
+
+	private static Pet pet(String name) {
+		Pet pet = new Pet();
+		pet.setName(name);
+		return pet;
+	}
+
+	@BeforeEach
+	void setUp() {
+		this.owner = new Owner();
+		this.leo = pet("Leo");
+		this.basil = pet("Basil");
+		this.owner.addPet(this.leo);
+		this.owner.addPet(this.basil);
+		this.leo.setId(1);
+		this.basil.setId(2);
+	}
+
+	@Test
+	void findsPetByNameIgnoringCase() {
+		assertThat(this.owner.getPet("Leo")).isSameAs(this.leo);
+		assertThat(this.owner.getPet("leo")).isSameAs(this.leo);
+		assertThat(this.owner.getPet("BASIL", true)).isSameAs(this.basil);
+		assertThat(this.owner.getPet("Rosy")).isNull();
+	}
+
+	@Test
+	void unsavedPetsAreFoundByNameUnlessIgnored() {
+		Pet fresh = pet("Fresh");
+		this.owner.addPet(fresh);
+		assertThat(this.owner.getPet("Fresh")).isSameAs(fresh);
+		assertThat(this.owner.getPet("Fresh", false)).isSameAs(fresh);
+		assertThat(this.owner.getPet("Fresh", true)).isNull();
+		assertThat(this.owner.getPet("Leo", true)).isSameAs(this.leo);
+	}
+
+	@Test
+	void findsPetById() {
+		assertThat(this.owner.getPet(1)).isSameAs(this.leo);
+		assertThat(this.owner.getPet(2)).isSameAs(this.basil);
+		assertThat(this.owner.getPet(3)).isNull();
+	}
+
+	@Test
+	void addsOnlyUnsavedPets() {
+		assertThat(this.owner.getPets()).hasSize(2);
+		this.owner.addPet(this.leo);
+		assertThat(this.owner.getPets()).hasSize(2);
+		Pet saved = pet("Saved");
+		saved.setId(9);
+		this.owner.addPet(saved);
+		assertThat(this.owner.getPets()).hasSize(2).doesNotContain(saved);
+		Pet fresh = pet("Fresh");
+		this.owner.addPet(fresh);
+		assertThat(this.owner.getPets()).hasSize(3).contains(fresh);
+	}
+
+	@Test
+	void addsVisitToThePetWithTheGivenId() {
+		Visit visit = new Visit();
+		visit.setDescription("rabies shot");
+		this.owner.addVisit(2, visit);
+		assertThat(this.basil.getVisits()).containsExactly(visit);
+		assertThat(this.leo.getVisits()).isEmpty();
+	}
+
+	@Test
+	void addingVisitToUnknownPetIsRejected() {
+		assertThatIllegalArgumentException().isThrownBy(() -> this.owner.addVisit(42, new Visit()));
+		assertThatIllegalArgumentException().isThrownBy(() -> this.owner.addVisit(null, new Visit()));
+		assertThatIllegalArgumentException().isThrownBy(() -> this.owner.addVisit(1, null));
+		assertThat(this.leo.getVisits()).isEmpty();
+	}
+
+}
