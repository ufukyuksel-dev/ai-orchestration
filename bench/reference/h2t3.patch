+package org.springframework.samples.petclinic.owner;
+
+import java.util.Comparator;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.samples.petclinic.system.Csv;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.server.ResponseStatusException;
+
+/**
+ * CSV export of an owner's visits. Deliberately not part of {@link OwnerController}: its
+ * model attribute fails with a 500 for unknown owner ids.
+ */
+@RestController
+class OwnerCsvController {
+
+	private final OwnerRepository owners;
+
+	OwnerCsvController(OwnerRepository owners) {
+		this.owners = owners;
+	}
+
+	@GetMapping(value = "/owners/{ownerId}/visits.csv", produces = Csv.TEXT_CSV)
+	String exportVisits(@PathVariable int ownerId) {
+		Owner owner = this.owners.findById(ownerId)
+			.orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "Owner not found: " + ownerId));
+		StringBuilder csv = new StringBuilder(Csv.line("pet", "date", "description"));
+		owner.getPets()
+			.stream()
+			.flatMap(pet -> pet.getVisits().stream().map(visit -> new PetVisit(pet.getName(), visit)))
+			.sorted(Comparator
+				.comparing((PetVisit row) -> row.visit().getDate(), Comparator.nullsLast(Comparator.naturalOrder()))
+				.thenComparing(PetVisit::pet, Comparator.nullsLast(Comparator.naturalOrder())))
+			.forEach(row -> csv.append(Csv.line(row.pet(), row.visit().getDate(), row.visit().getDescription())));
+		return csv.toString();
+	}
+
+	private record PetVisit(String pet, Visit visit) {
+	}
+
+}
