+from datetime import timezone
+import sqlalchemy as sa
+from flask import request
+from app import db
+from app.models import User, Message
+from app.api import bp
+from app.api.auth import token_auth
+from app.api.errors import bad_request
+
+
+def message_to_dict(message):
+    return {
+        'id': message.id,
+        'body': message.body,
+        'timestamp': message.timestamp.replace(
+            tzinfo=timezone.utc).isoformat(),
+        'sender': {'id': message.author.id,
+                   'username': message.author.username},
+        'recipient': {'id': message.recipient.id,
+                      'username': message.recipient.username},
+    }
+
+
+@bp.route('/messages', methods=['POST'])
+@token_auth.login_required
+def send_message():
+    data = request.get_json(silent=True)
+    if not isinstance(data, dict) or \
+            not isinstance(data.get('recipient'), str) or \
+            not isinstance(data.get('body'), str):
+        return bad_request('must include recipient and body fields')
+    if not data['body'] or len(data['body']) > 140:
+        return bad_request('body must be between 1 and 140 characters')
+    user = db.first_or_404(
+        sa.select(User).where(User.username == data['recipient']))
+    msg = Message(author=token_auth.current_user(), recipient=user,
+                  body=data['body'])
+    db.session.add(msg)
+    user.add_notification('unread_message_count',
+                          user.unread_message_count())
+    db.session.commit()
+    return message_to_dict(msg), 201
