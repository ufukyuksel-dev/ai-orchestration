+package org.springframework.samples.petclinic.vet;
+
+import java.util.Comparator;
+import java.util.stream.Collectors;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.system.Csv;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/**
+ * CSV export of the veterinarians.
+ */
+@RestController
+class VetCsvController {
+
+	private final VetRepository vetRepository;
+
+	VetCsvController(VetRepository vetRepository) {
+		this.vetRepository = vetRepository;
+	}
+
+	@GetMapping(value = "/vets.csv", produces = Csv.TEXT_CSV)
+	String exportVets() {
+		StringBuilder csv = new StringBuilder(Csv.line("id", "firstName", "lastName", "specialties"));
+		this.vetRepository.findAll().stream().sorted(Comparator.comparing(Vet::getId)).forEach(vet -> {
+			// Vet#getSpecialties() is already sorted by name
+			String specialties = vet.getSpecialties()
+				.stream()
+				.map(NamedEntity::getName)
+				.collect(Collectors.joining(";"));
+			csv.append(Csv.line(vet.getId(), vet.getFirstName(), vet.getLastName(), specialties));
+		});
+		return csv.toString();
+	}
+
+}
