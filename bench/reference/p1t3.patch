+from datetime import timezone
+from flask import request, url_for
+from app import db
+from app.models import Message
+from app.api import bp
+from app.api.auth import token_auth
+
+
+def message_to_dict(message):
+    return {
+        'id': message.id,
+        'body': message.body,
+        'timestamp': message.timestamp.replace(
+            tzinfo=timezone.utc).isoformat(),
+        'sender': {'id': message.author.id,
+                   'username': message.author.username},
+    }
+
+
+@bp.route('/messages', methods=['GET'])
+@token_auth.login_required
+def get_messages():
+    user = token_auth.current_user()
+    page = request.args.get('page', 1, type=int)
+    per_page = min(request.args.get('per_page', 10, type=int), 100)
+    query = user.messages_received.select().order_by(
+        Message.timestamp.desc(), Message.id.desc())
+    messages = db.paginate(query, page=page, per_page=per_page,
+                           error_out=False)
+    return {
+        'items': [message_to_dict(m) for m in messages.items],
+        '_meta': {
+            'page': page,
+            'per_page': per_page,
+            'total_pages': messages.pages,
+            'total_items': messages.total,
+        },
+        '_links': {
+            'self': url_for('api.get_messages', page=page,
+                            per_page=per_page),
+            'next': url_for('api.get_messages', page=page + 1,
+                            per_page=per_page) if messages.has_next else None,
+            'prev': url_for('api.get_messages', page=page - 1,
+                            per_page=per_page) if messages.has_prev else None,
+        },
+    }
