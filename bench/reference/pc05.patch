+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.owner;
+
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.stereotype.Service;
+
+/**
+ * Owner use cases shared by the web controllers: looking up, searching and saving owners.
+ */
+@Service
+public class OwnerService {
+
+	private static final int PAGE_SIZE = 5;
+
+	private final OwnerRepository owners;
+
+	public OwnerService(OwnerRepository owners) {
+		this.owners = owners;
+	}
+
+	/**
+	 * Return the owner with the given id.
+	 * @param ownerId the id of the owner
+	 * @return the owner, never {@code null}
+	 * @throws IllegalArgumentException if no owner with that id exists
+	 */
+	public Owner findOwner(int ownerId) {
+		return this.owners.findById(ownerId)
+			.orElseThrow(() -> new IllegalArgumentException("Owner not found with id: " + ownerId
+					+ ". Please ensure the ID is correct " + "and the owner exists in the database."));
+	}
+
+	/**
+	 * Return one page of the owners whose last name starts with the given prefix.
+	 * @param lastNamePrefix the start of the last name ({@code ""} for all owners)
+	 * @param page the 1-based page number
+	 * @return the page, with at most 5 owners
+	 */
+	public Page<Owner> findOwnersByLastName(String lastNamePrefix, int page) {
+		return this.owners.findByLastNameStartingWith(lastNamePrefix, PageRequest.of(page - 1, PAGE_SIZE));
+	}
+
+	/**
+	 * Save the given owner with its pets and visits.
+	 * @param owner the owner to save
+	 * @return the saved owner
+	 */
+	public Owner save(Owner owner) {
+		return this.owners.save(owner);
+	}
+
+}
