@@ -0,0 +1,37 @@
+package articles
+
+import (
+	"errors"
+	"net/http"
+	"sort"
+	"strconv"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gothinkster/golang-gin-realworld-example-app/common"
+)
+
+// ArticleCommentsCSV exports the comments of one article, oldest first.
+func ArticleCommentsCSV(c *gin.Context) {
+	articleModel, err := FindOneArticle(&ArticleModel{Slug: c.Param("slug")})
+	if err != nil {
+		c.JSON(http.StatusNotFound, common.NewError("comments", errors.New("Invalid slug")))
+		return
+	}
+	if err := articleModel.getComments(); err != nil {
+		c.JSON(http.StatusInternalServerError, common.NewError("comments", errors.New("Database error")))
+		return
+	}
+	comments := articleModel.Comments
+	sort.SliceStable(comments, func(i, j int) bool {
+		if !comments[i].CreatedAt.Equal(comments[j].CreatedAt) {
+			return comments[i].CreatedAt.Before(comments[j].CreatedAt)
+		}
+		return comments[i].ID < comments[j].ID
+	})
+	records := [][]string{{"id", "author", "body", "createdAt"}}
+	for _, cm := range comments {
+		records = append(records, []string{strconv.FormatUint(uint64(cm.ID), 10), cm.Author.UserModel.Username, cm.Body,
+			cm.CreatedAt.UTC().Format(csvDateFormat)})
+	}
+	writeCSV(c, records)
+}
diff --git a/articles/csv.go b/articles/csv.go
